# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Canonical app URL.
# Local development can omit this because getSiteUrl() falls back to http://localhost:3000.
# Production should set this to your custom domain so OAuth callbacks use the right host.
NEXT_PUBLIC_SITE_URL=https://visa.shoaibq.dev

# Vercel provides NEXT_PUBLIC_VERCEL_URL automatically for deployments.
# Do not set it locally unless you specifically want to test that fallback.
# NEXT_PUBLIC_VERCEL_URL=your-project.vercel.app

# Optional. If omitted, the app uses 2026-08-15T23:59:59Z.
NEXT_PUBLIC_ACCESS_EXPIRES_AT=2026-08-15T23:59:59Z
